# ==============================================================================
# OMS (Order Management System) Production Environment Configuration Template
# Instructions: Copy this file to '.env' in the root folder, and fill in the values.
# ==============================================================================

# ---------------- Database Settings ----------------
MYSQL_ROOT_PASSWORD=change_this_to_a_strong_root_password
DB_NAME=oms_db
DB_USERNAME=oms_user
DB_PASSWORD=change_this_to_a_strong_db_password
DB_PORT=3306
# Use update only for the first bootstrap, then switch to validate.
HIBERNATE_DDL_AUTO=update

# ---------------- Security & Auth Configurations ----------------
# Generate a strong base64 key: openssl rand -base64 32
JWT_SECRET=your_super_secret_base64_key
JWT_ACCESS_EXPIRATION=86400000
JWT_REFRESH_EXPIRATION=604800000

# ---------------- Google OAuth Integration ----------------
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# ---------------- Gemini AI Key ----------------
GEMINI_API_KEY=your_gemini_api_key

# ---------------- Facebook/Messenger Integration ----------------
MESSENGER_VERIFY_TOKEN=your_custom_webhook_verify_token
MESSENGER_PAGE_ID=your_fb_page_id
MESSENGER_PAGE_ACCESS_TOKEN=your_fb_page_access_token
MESSENGER_DEFAULT_SHOP_ID=1

# ---------------- PayOS Payment Settings ----------------
PAYOS_ENABLED=false
PAYOS_CLIENT_ID=your_payos_client_id
PAYOS_API_KEY=your_payos_api_key
PAYOS_CHECKSUM_KEY=your_payos_checksum_key

# ---------------- Public URL & CORS Settings ----------------
# Set this to the public domain where the system is hosted
PUBLIC_FRONTEND_BASE_URL=https://your-domain.com
PUBLIC_ORDER_TRACKING_SECRET=change_this_to_a_random_secret
CORS_ORIGINS=https://your-domain.com,https://www.your-domain.com

# ---------------- Order Cancellation Timeout ----------------
PAYMENT_CANCEL_MINUTES=30
PAYMENT_REMINDER_MINUTES=25
